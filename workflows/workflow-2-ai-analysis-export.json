    {
      "parameters": {
        "jsCode": "return items.map((item, index) => {\n    // 1. Récupérer le texte brut de Claude\n    let text = item.json.content.find(c => c.type === 'text').text;\n    \n    // 2. Nettoyer les balises Markdown ```json et ```\n    text = text.replace(/```json/g, '').replace(/```/g, '').trim();\n    \n    let aiData = {};\n    try {\n        aiData = JSON.parse(text);\n    } catch (e) {\n        aiData = { angle: \"Erreur de parsing\", accroche: \"\", priorite: \"0\" };\n    }\n\n    // 3. Récupérer TOUTES les données d'origine depuis le nœud SQL renommé\n    let originalData = $('SQL_Get_Prospects').all()[index].json;\n\n    // 4. Fusionner : toutes les données SQL d'origine + les nouvelles de l'IA\n    return {\n        json: {\n            ...originalData,\n            ...aiData\n        }\n    };\n});"
      },
      "type": "n8n-nodes-base.code",
