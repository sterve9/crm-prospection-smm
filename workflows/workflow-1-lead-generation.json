      ],
      "parameters": {
        "jsCode": "// Contacts, reseaux et signaux d'activite, a partir de ce qu'Apify renvoie.\nconst source = $('C04-N01 - Nettoyage des prospects').all();\nconst brut = $('C03-N02 - Lancer la collecte Apify').all();\nif (source.length !== items.length || brut.length !== items.length) {\n  throw new Error('Appariement impossible : ' + items.length + ' items, ' + source.length + ' nettoyes, ' + brut.length + ' bruts.');\n}\n\nfunction hote(u) {\n  try { return new URL(u).hostname.replace(/^www\\./, '').toLowerCase(); }\n  catch (e) { return ''; }\n}\n\nfunction sansAccent(s) {\n  return String(s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();\n}\n\n// Mots de metier trop generiques pour identifier une enseigne en propre\nconst GENERIQUES = ['boulangerie','boulanger','patisserie','patissier','restaurant','brasserie','maison','artisan','artisanale','viennoiserie','traiteur','bistro','france','lyon','paris'];\n\nfunction marqueurs(nom) {\n  return sansAccent(nom).split(/[^a-z0-9]+/)\n    .filter(t => t.length >= 5 && GENERIQUES.indexOf(t) === -1);\n}\n\nreturn items.map((item, index) => {\n  const p = { ...source[index].json };\n  const a = brut[index].json;\n  const domaine = String(a.domain || '').replace(/^www\\./, '').toLowerCase();\n  const mots = marqueurs(p.nom);\n\n  // PIEGE MESURE LE 04/09/2026 : pour \"Le 9eme Pain\", Apify a renvoye les\n  // reseaux de LWS, l'hebergeur du site. 170 000 abonnes attribues a une\n  // boulangerie de quartier.\n  // DEUX preuves d'appartenance sont acceptees :\n  //  1. le profil renvoie vers le domaine du prospect ;\n  //  2. le nom du compte porte un mot distinctif de l'enseigne.\n  // La seconde a ete ajoutee le 04/09 : la preuve 1 seule rejetait de\n  // vrais comptes, car beaucoup mettent un Linktree en lien externe.\n  function verifie(profils, urls) {\n    const liste = Array.isArray(profils) ? profils : [];\n    for (const pr of liste) {\n      if (domaine && hote(pr.externalProfileURL || '') === domaine) {\n        return { url: pr.profileURL || '', profil: pr, etat: 'domaine' };\n      }\n    }\n    for (const pr of liste) {\n      const cible = sansAccent(pr.username) + ' ' + sansAccent(pr.profileName);\n      if (mots.some(m => cible.indexOf(m) !== -1)) {\n        return { url: pr.profileURL || '', profil: pr, etat: 'nom' };\n      }\n    }\n    if (liste.length > 0) {\n      // On note CE QUI a ete rejete : sans ca, un faux negatif est invisible.\n      const vus = liste.map(pr => pr.username || hote(pr.externalProfileURL || '') || '?').join('+');\n      return { url: '', profil: null, etat: 'rejete[' + vus + ']' };\n    }\n    const u = Array.isArray(urls) && urls.length ? urls[0] : '';\n    return { url: u, profil: null, etat: u ? 'non_verifie' : 'absent' };\n  }\n\n  const fb = verifie(a.facebookProfiles, a.facebooks);\n  const ig = verifie(a.instagramProfiles, a.instagrams);\n\n  // LinkedIn : uniquement une page ENTREPRISE. Mesure du 04/09 : sur\n  // \"Boulangerie des Canuts\", linkedIns[0] valait /in/jessica-helme,\n  // un profil personnel sans rapport avec le commerce.\n  const liListe = Array.isArray(a.linkedIns) ? a.linkedIns : [];\n  const li = liListe.filter(u => /linkedin\\.com\\/company\\//i.test(u))[0] || '';\n\n  let email = Array.isArray(a.emails) && a.emails.length ? a.emails[0] : '';\n  if (!email && fb.profil && fb.profil.email) email = fb.profil.email;\n\n  p.email = email;\n  p.facebook = fb.url;\n  p.instagram = ig.url;\n  p.linkedin = li;\n\n  p.instagram_abonnes = ig.profil ? (ig.profil.followersCount || 0) : 0;\n  p.instagram_publications = ig.profil ? (ig.profil.postsCount || 0) : 0;\n  p.facebook_abonnes = fb.profil ? (fb.profil.likes || 0) : 0;\n  p.fiche_non_revendiquee = a.claimThisBusiness === true;\n\n  // Distingue \"aucun compte\" de \"compte non identifie\" : l'IA ne doit pas\n  // affirmer une absence qui n'a pas ete verifiee.\n  p.detection_sociale = (ig.profil || fb.profil) ? 'confirmee'\n    : (ig.etat.indexOf('rejete') === 0 || fb.etat.indexOf('rejete') === 0 || ig.etat === 'non_verifie' || fb.etat === 'non_verifie') ? 'incertaine'\n    : 'aucun_compte_trouve';\n\n  p.enrichissement = 'fb:' + fb.etat + ' ig:' + ig.etat + (domaine ? '' : ' sans_domaine');\n\n  return { json: p };\n});"
      }
    }
  ],
